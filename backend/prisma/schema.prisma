generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  ACKNOWLEDGED
  CONFIRMED
}

enum AssignmentType {
  INDIVIDUAL
  GROUP
}

model User {
  id                 String       @id @default(cuid())
  name               String
  email              String       @unique
  password           String
  role               Role         @default(STUDENT)
  groupsCreated      Group[]      @relation("GroupCreator")
  memberships        GroupMember[]
  enrollments         StudentCourse[]
  coursesTaught       Course[]       @relation("CourseProfessor")
  assignmentsCreated Assignment[] @relation("AssignmentCreator")
  submissions        Submission[] @relation("SubmissionConfirmer")
  individualSubmissions Submission[] @relation("SubmissionStudent")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([role])
}

model Course {
  id          String          @id @default(cuid())
  name        String
  code        String          @unique
  description String
  professorId String
  professor   User            @relation("CourseProfessor", fields: [professorId], references: [id], onDelete: Restrict)
  enrollments StudentCourse[]
  assignments Assignment[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([professorId])
}

model StudentCourse {
  id         String   @id @default(cuid())
  studentId  String
  courseId   String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
}

model Group {
  id          String            @id @default(cuid())
  name        String
  createdById String
  createdBy   User              @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members     GroupMember[]
  assignments AssignmentGroup[]
  submissions Submission[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([createdById])
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  studentId String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@unique([groupId, studentId])
  @@index([studentId])
  @@index([groupId])
}

model Assignment {
  id               String            @id @default(cuid())
  title            String
  description      String
  dueDate          DateTime
  oneDriveLink     String
  submissionType   AssignmentType     @default(GROUP)
  courseId         String?
  createdById      String
  course           Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdBy        User              @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignmentGroups AssignmentGroup[]
  submissions      Submission[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([createdById])
  @@index([dueDate])
  @@index([courseId])
}

model AssignmentGroup {
  id           String     @id @default(cuid())
  assignmentId String
  groupId      String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  group        Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  assignedAt   DateTime   @default(now())

  @@unique([assignmentId, groupId])
  @@index([assignmentId])
  @@index([groupId])
}

model Submission {
  id            String           @id @default(cuid())
  assignmentId  String
  groupId       String
  studentId     String?
  confirmedById String?
  confirmedBy   User?            @relation("SubmissionConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)
  confirmedAt   DateTime?
  status        SubmissionStatus @default(PENDING)
  assignment    Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  group         Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student       User?            @relation("SubmissionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([assignmentId, groupId, studentId])
  @@index([assignmentId])
  @@index([groupId])
  @@index([status])
  @@index([studentId])
  @@unique([assignmentId, studentId])
}
